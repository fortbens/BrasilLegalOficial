rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Site settings & App settings: readable by everyone (public landing page), writable by authenticated users
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Users collection: accessible for authenticated users, readable for system authentication checks
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Contacts / Leads: anyone can submit a new lead from the public page, auth users can manage
    match /contacts/{contactId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() || true;
    }

    // Documents: dossiers and documents
    match /documents/{docId} {
      allow read, write: if true;
    }

    // Deals / Opportunities: pipeline
    match /deals/{dealId} {
      allow read, write: if true;
    }

    // Properties: cadastros imobiliários
    match /properties/{propId} {
      allow read, write: if true;
    }

    // Financial Records
    match /financial_records/{recordId} {
      allow read, write: if true;
    }

    // Omnichannel chats / messages
    match /whatsapp_chats/{chatId} {
      allow read, write: if true;
    }

    // Meta ads configurations & metrics
    match /meta_ads/{adId} {
      allow read, write: if true;
    }

    // Default rule for other collections
    match /{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
  }
}
